<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into the Windows runtimes by build-runtimes.mjs: run them with UTF-8 as the
     process code page, so paths like C:\Users\محمد\… reach the C file APIs intact. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
