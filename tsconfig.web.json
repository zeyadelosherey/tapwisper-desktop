{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/renderer/**/*.json"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "outDir": "./out/types-web",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"]
    }
  }
}
